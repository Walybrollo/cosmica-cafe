rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo estos correos pueden ver y cargar datos. Para sumar a alguien, agregá su correo a la lista.
    function esDelEquipo() {
      return request.auth != null
        && request.auth.token.email in ['walyb17@gmail.com', 'micasanz888@gmail.com'];
    }
    // Todas las listas de la app: productos, ventas, gastos, cierres, insumos y movimientos.
    match /{lista}/{id} { allow read, write: if esDelEquipo(); }
  }
}
